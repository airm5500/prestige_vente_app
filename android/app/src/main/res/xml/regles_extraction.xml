<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde cloud et transfert d'appareil (Android 12+) : stockage sécurisé exclu (jeton du téléphone,
     modèles d'empreinte du pointage RH, gardés uniquement sur ce terminal). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
