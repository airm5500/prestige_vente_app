<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Appareil photo : scan DataMatrix et photo d'ordonnance (facultatif : terminaux sans caméra) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Lecteur d'empreinte (pointage) : facultatif, l'application s'installe aussi sans -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <!-- Badges NFC (pointage) : facultatif, l'application s'installe aussi sans NFC. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Position (pointage RH par téléphone, si l'officine l'exige) : facultatif, demandée au pointage. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <application
        android:label="Prestige Mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/regles_sauvegarde"
        android:dataExtractionRules="@xml/regles_extraction"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="false">
        <!-- 4.5.0 (Google Play, targetSdk 36 du bundle Play seulement) : comportements d'avant Android 16 gardés.
             - enableOnBackInvokedCallback="false" : pas de retour prédictif, la touche / le geste retour arrive à
               l'application comme aujourd'hui (borne, kiosque, PopScope). Valeur par défaut jusqu'à targetSdk 35 :
               aucun effet sur les APK Sunmi.
             - PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY : sur grand écran (≥ 600 dp) Android 16 ignore sinon
               l'orientation imposée (capture guidée en portrait). Ignorée en targetSdk 35 ; dérogation temporaire
               d'Android 16, à revoir pour targetSdk 37. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 4.10.0 : bouton « Pointer » : présence et ouverture de Prestige Pointage (Android 11+, visibilité des paquets) -->
        <package android:name="com.dici.prestigepointage" />
        <!-- Bouton « Appeler l'assistance » (écran de connexion) : composeur téléphonique (Android 11+) -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Service d'empreinte Sunmi (visibilité des paquets, Android 11+) -->
        <intent>
            <action android:name="com.sunmi.fingerprint.service"/>
        </intent>
        <package android:name="com.sunmi.fingerprintservice"/>
        <package android:name="com.sunmi.fingerprint"/>
        <package android:name="com.sunmi.biometric"/>
        <package android:name="com.sunmi.fingerprintserver"/>
    </queries>
</manifest>
