new file mode 100644
index 00000000..4db52eb8
--- /dev/null
+++ b/src/main/java/util/paiements/Signatures.java
@@ -0,0 +1,39 @@
+package util.paiements;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Locale;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/** HMAC-SHA256 et comparaison à temps constant (même principe que le webhook WhatsApp). */
+public final class Signatures {
+
+    private Signatures() {
+    }
+
+    public static String hmacHex(String secret, String donnees) {
+        try {
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
+            byte[] h = mac.doFinal(donnees.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder(h.length * 2);
+            for (byte b : h) {
+                sb.append(String.format("%02x", b));
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            throw new IllegalStateException("HMAC indisponible", e);
+        }
+    }
+
+    /** Signature hexadécimale attendue, comparée sans fuite de temps ; faux si un élément manque. */
+    public static boolean valide(String secret, String donnees, String recue) {
+        if (secret == null || secret.isBlank() || donnees == null || recue == null || recue.isBlank()) {
+            return false;
+        }
+        byte[] a = hmacHex(secret, donnees).getBytes(StandardCharsets.US_ASCII);
+        byte[] b = recue.trim().toLowerCase(Locale.ROOT).getBytes(StandardCharsets.US_ASCII);
+        return MessageDigest.isEqual(a, b);
+    }
+}
diff --git a/src/main/java/util/paiements/SimulateurPaiement.java b/src/main/java/util/paiements/SimulateurPaiement.java
new file mode 100644
index 00000000..8b966f52
--- /dev/null
+++ b/src/main/java/util/paiements/SimulateurPaiement.java
@@ -0,0 +1,89 @@
+package util.paiements;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Function;
+import org.json.JSONObject;
+
+/**
+ * B3 : agrégateur FACTICE complet (tests, démonstration, formation) : lien « simulateur://… », paiement simulé par
+ * {@link #payer} / {@link #refuser} (route réservée aux utilisateurs connectés, active seulement avec ce fournisseur),
+ * notification signée HMAC-SHA256 (en-tête {@code X-Simulateur-Signature}) et revérification du statut, exactement
+ * comme un vrai fournisseur. Aucun argent ne circule.
+ */
+public final class SimulateurPaiement implements FournisseurPaiement {
+
+    public static final String ENTETE_SIGNATURE = "X-Simulateur-Signature";
+
+    /** Transactions simulées (mémoire du serveur). */
+    private static final Map<String, Etat> ETATS = new ConcurrentHashMap<>();
+    private static final Map<String, Integer> MONTANTS = new ConcurrentHashMap<>();
+
+    private final String secret;
+
+    public SimulateurPaiement(String secret) {
+        this.secret = secret;
+    }
+
+    @Override
+    public String code() {
+        return "simulateur";
+    }
+
+    @Override
+    public List<Operateur> operateurs() {
+        return Arrays.asList(Operateur.values());
+    }
+
+    @Override
+    public Creation creer(Demande d) {
+        MONTANTS.put(d.transactionId, d.montant);
+        ETATS.put(d.transactionId, new Etat(Resultat.EN_ATTENTE, d.montant, d.devise, null, null));
+        return new Creation("SIM-" + d.transactionId,
+                "simulateur://payer/" + d.transactionId + "?montant=" + d.montant + "&operateur=" + d.operateur.code());
+    }
+
+    /** Le client « paie » ; renvoie le corps de la notification (à signer par {@link #signer}). */
+    public String payer(String transactionId, Integer montantPaye) {
+        Integer m = montantPaye != null ? montantPaye : MONTANTS.get(transactionId);
+        ETATS.put(transactionId, new Etat(Resultat.PAYE, m, "XOF", "SIM-OP-" + transactionId, null));
+        return new JSONObject().put("transaction_id", transactionId).put("statut", "paye").toString();
+    }
+
+    public String refuser(String transactionId) {
+        ETATS.put(transactionId,
+                new Etat(Resultat.ECHOUE, MONTANTS.get(transactionId), "XOF", null, "Solde insuffisant"));
+        return new JSONObject().put("transaction_id", transactionId).put("statut", "echoue").toString();
+    }
+
+    public String signer(String corps) {
+        return Signatures.hmacHex(secret, corps);
+    }
+
+    @Override
+    public String lireNotification(String corpsBrut, Function<String, String> entete) {
+        if (!Signatures.valide(secret, corpsBrut, entete.apply(ENTETE_SIGNATURE))) {
+            return null;
+        }
+        try {
+            String id = new JSONObject(corpsBrut).optString("transaction_id", "");
+            return id.isEmpty() ? null : id;
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public Etat verifier(String transactionId, String refFournisseur) {
+        Etat e = ETATS.get(transactionId);
+        return e != null ? e : new Etat(Resultat.EN_ATTENTE, null, null, null, "Transaction inconnue du simulateur");
+    }
+
+    /** Oublie tout (tests). */
+    static void vider() {
+        ETATS.clear();
+        MONTANTS.clear();
+    }
+}
diff --git a/src/main/java/util/paiements/StatutPaiement.java b/src/main/java/util/paiements/StatutPaiement.java
new file mode 100644
index 00000000..d89842ef
--- /dev/null
+++ b/src/main/java/util/paiements/StatutPaiement.java
@@ -0,0 +1,38 @@
+package util.paiements;
+
+/**
+ * B3 (Prestige Mobile) : statut d'un paiement mobile money. Les transitions sont dans {@link TransitionsPaiement} : un
+ * paiement payé ne redevient jamais « en attente », une vente n'est jamais clôturée deux fois, un paiement arrivé APRÈS
+ * une annulation ou une expiration est signalé (régularisation) et ne clôture rien.
+ */
+public enum StatutPaiement {
+    EN_ATTENTE("en_attente"), PAYE("paye"), ECHOUE("echoue"), EXPIRE("expire"), ANNULE("annule"),
+    /**
+     * Argent reçu alors que le paiement était annulé ou expiré : à régulariser au comptoir (remboursement ou vente).
+     */
+    PAYE_APRES_ANNULATION("paye_apres_annulation");
+
+    public final String code;
+
+    StatutPaiement(String code) {
+        this.code = code;
+    }
+
+    /** Plus rien n'est attendu du fournisseur (sauf un paiement tardif, toujours signalé). */
+    public boolean termine() {
+        return this != EN_ATTENTE;
+    }
+
+    public boolean argentRecu() {
+        return this == PAYE || this == PAYE_APRES_ANNULATION;
+    }
+
+    public static StatutPaiement de(String code) {
+        for (StatutPaiement s : values()) {
+            if (s.code.equals(code)) {
+                return s;
+            }
+        }
+        return EN_ATTENTE;
+    }
+}
diff --git a/src/main/java/util/paiements/TransitionsPaiement.java b/src/main/java/util/paiements/TransitionsPaiement.java
new file mode 100644
index 00000000..3a0af9e5
--- /dev/null
+++ b/src/main/java/util/paiements/TransitionsPaiement.java
@@ -0,0 +1,66 @@
+package util.paiements;
+
+import util.paiements.FournisseurPaiement.Etat;
+import util.paiements.FournisseurPaiement.Resultat;
+
+/**
+ * B3 : application d'un statut lu chez le fournisseur à un paiement. Idempotent (une notification répétée ne change
+ * rien), montant et devise contrôlés, aucun retour en arrière.
+ */
+public final class TransitionsPaiement {
+
+    private TransitionsPaiement() {
+    }
+
+    /** Résultat : nouveau statut (égal à l'ancien si rien ne change) et motif éventuel (anomalie). */
+    public static final class Decision {
+        public final StatutPaiement statut;
+        public final String anomalie;
+
+        Decision(StatutPaiement statut, String anomalie) {
+            this.statut = statut;
+            this.anomalie = anomalie;
+        }
+
+        public boolean change(StatutPaiement avant) {
+            return statut != avant;
+        }
+    }
+
+    public static Decision appliquer(StatutPaiement actuel, int montantAttendu, String deviseAttendue, Etat e) {
+        if (e == null || e.resultat == Resultat.EN_ATTENTE) {
+            return new Decision(actuel, null);
+        }
+        if (e.resultat == Resultat.ECHOUE) {
+            return new Decision(actuel == StatutPaiement.EN_ATTENTE ? StatutPaiement.ECHOUE : actuel, null);
+        }
+        // PAYE : montant et devise doivent correspondre exactement (jamais le montant envoyé par un client).
+        if (e.montant == null || e.montant != montantAttendu) {
+            return new Decision(actuel,
+                    "Montant payé (" + e.montant + ") différent du montant attendu (" + montantAttendu + ")");
+        }
+        if (e.devise != null && deviseAttendue != null && !deviseAttendue.equalsIgnoreCase(e.devise)) {
+            return new Decision(actuel, "Devise payée (" + e.devise + ") différente de " + deviseAttendue);
+        }
+        switch (actuel) {
+        case EN_ATTENTE:
+        case ECHOUE:
+            return new Decision(StatutPaiement.PAYE, null);
+        case ANNULE:
+        case EXPIRE:
+            return new Decision(StatutPaiement.PAYE_APRES_ANNULATION, "Paiement reçu après annulation : à régulariser");
+        default:
+            return new Decision(actuel, null); // déjà payé : notification répétée
+        }
+    }
+
+    /** Annulation demandée : seulement si le paiement est encore en attente. */
+    public static StatutPaiement annuler(StatutPaiement actuel) {
+        return actuel == StatutPaiement.EN_ATTENTE ? StatutPaiement.ANNULE : actuel;
+    }
+
+    /** Expiration : seulement si le paiement est encore en attente. */
+    public static StatutPaiement expirer(StatutPaiement actuel) {
+        return actuel == StatutPaiement.EN_ATTENTE ? StatutPaiement.EXPIRE : actuel;
+    }
+}
diff --git a/src/main/java/util/paiements/WaveFournisseur.java b/src/main/java/util/paiements/WaveFournisseur.java
new file mode 100644
index 00000000..3c11f83d
--- /dev/null
+++ b/src/main/java/util/paiements/WaveFournisseur.java
@@ -0,0 +1,118 @@
+package util.paiements;
+
+import java.io.IOException;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import org.json.JSONObject;
+
+/**
+ * B3 : adaptateur Wave Business (API Checkout), Wave seulement.
+ * <p>
+ * <b>À VALIDER AVEC LA DOCUMENTATION DU COMPTE MARCHAND</b> — écrit d'après la documentation publique Wave connue :
+ * <ul>
+ * <li>création : {@code POST https://api.wave.com/v1/checkout/sessions}, {@code Authorization: Bearer <clé API>}, JSON
+ * amount (texte), currency XOF, success_url, error_url, client_reference → id (cos-…), wave_launch_url ;</li>
+ * <li>webhook : en-tête {@code Wave-Signature: t=<horodatage>,v1=<hex>} = HMAC-SHA256(horodatage + corps brut) avec le
+ * secret du webhook ; événement checkout.session.completed (data.client_reference = notre transaction) ;</li>
+ * <li>vérification : {@code GET https://api.wave.com/v1/checkout/sessions/{id}} → checkout_status, payment_status
+ * (succeeded), amount, currency.</li>
+ * </ul>
+ * Les notifications de plus de 5 minutes sont refusées (rejeu).
+ */
+public final class WaveFournisseur implements FournisseurPaiement {
+
+    static final String BASE = "https://api.wave.com/v1";
+    static final long FENETRE_SECONDES = 300;
+
+    private final HttpPaiements http;
+    private final String apiKey;
+    private final String webhookSecret;
+    /** Horloge (tests). */
+    java.util.function.LongSupplier maintenant = () -> System.currentTimeMillis() / 1000;
+
+    public WaveFournisseur(HttpPaiements http, String apiKey, String webhookSecret) {
+        this.http = http;
+        this.apiKey = apiKey;
+        this.webhookSecret = webhookSecret;
+    }
+
+    @Override
+    public String code() {
+        return "wave";
+    }
+
+    @Override
+    public List<Operateur> operateurs() {
+        return Collections.singletonList(Operateur.WAVE);
+    }
+
+    private Map<String, String> entetes() {
+        return Map.of("Authorization", "Bearer " + apiKey, "Content-Type", "application/json");
+    }
+
+    @Override
+    public Creation creer(Demande d) throws IOException {
+        JSONObject b = new JSONObject().put("amount", String.valueOf(d.montant)).put("currency", d.devise)
+                .put("success_url", d.urlRetour).put("error_url", d.urlRetour).put("client_reference", d.transactionId);
+        HttpPaiements.Reponse r = http.envoyer("POST", BASE + "/checkout/sessions", entetes(), b.toString());
+        JSONObject o = new JSONObject(r.corps == null || r.corps.isBlank() ? "{}" : r.corps);
+        if (r.statut / 100 != 2 || o.optString("wave_launch_url").isEmpty()) {
+            throw new IOException("Wave a refusé la création (" + r.statut + " " + o.optString("message") + ")");
+        }
+        return new Creation(o.getString("id"), o.getString("wave_launch_url"));
+    }
+
+    @Override
+    public String lireNotification(String corpsBrut, Function<String, String> entete) {
+        String sig = entete.apply("Wave-Signature");
+        if (sig == null || corpsBrut == null) {
+            return null;
+        }
+        String t = null;
+        String v1 = null;
+        for (String part : sig.split(",")) {
+            String[] kv = part.trim().split("=", 2);
+            if (kv.length == 2 && "t".equals(kv[0])) {
+                t = kv[1];
+            } else if (kv.length == 2 && "v1".equals(kv[0])) {
+                v1 = kv[1];
+            }
+        }
+        if (t == null || v1 == null || !Signatures.valide(webhookSecret, t + corpsBrut, v1)) {
+            return null;
+        }
+        try {
+            if (Math.abs(maintenant.getAsLong() - Long.parseLong(t)) > FENETRE_SECONDES) {
+                return null;
+            }
+            JSONObject data = new JSONObject(corpsBrut).optJSONObject("data");
+            String ref = data == null ? "" : data.optString("client_reference", "");
+            return ref.isEmpty() ? null : ref;
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public Etat verifier(String transactionId, String refFournisseur) throws IOException {
+        if (refFournisseur == null || refFournisseur.isBlank()) {
+            return new Etat(Resultat.EN_ATTENTE, null, null, null, "Session Wave inconnue");
+        }
+        HttpPaiements.Reponse r = http.envoyer("GET", BASE + "/checkout/sessions/" + refFournisseur, entetes(), null);
+        JSONObject o = new JSONObject(r.corps == null || r.corps.isBlank() ? "{}" : r.corps);
+        if (r.statut / 100 != 2) {
+            return new Etat(Resultat.EN_ATTENTE, null, null, null, "Wave : code " + r.statut);
+        }
+        if (!transactionId.equals(o.optString("client_reference"))) {
+            return new Etat(Resultat.EN_ATTENTE, null, null, null, "Session Wave d'une autre transaction");
+        }
+        String ps = o.optString("payment_status", "");
+        String cs = o.optString("checkout_status", "");
+        Integer montant = o.has("amount") ? (int) Math.round(Double.parseDouble(o.optString("amount", "0"))) : null;
+        Resultat res = "succeeded".equals(ps) ? Resultat.PAYE
+                : ("cancelled".equals(ps) || "expired".equals(cs)) ? Resultat.ECHOUE : Resultat.EN_ATTENTE;
+        return new Etat(res, montant, o.optString("currency", null), o.optString("transaction_id", null), ps);
+    }
+}
